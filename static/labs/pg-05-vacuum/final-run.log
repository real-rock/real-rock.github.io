######## 1. UPDATE를 하면 dead tuple이 쌓인다

$ psql -X <<'SQL'
$ SELECT pg_size_pretty(pg_relation_size('t')) AS size, pg_relation_size('t') / 8192 AS pages;
$ UPDATE t SET v = v + 1;
$ SELECT pg_size_pretty(pg_relation_size('t')) AS size, pg_relation_size('t') / 8192 AS pages;
$ SQL
$ sleep 2
$ psql -X -c "SELECT n_live_tup, n_dead_tup FROM pg_stat_user_tables WHERE relname = 't'"
