######## 7. VACUUM FULL은 테이블을 새로 쓴다

$ psql -X <<'SQL'
$ DELETE FROM t WHERE id % 2 = 0;
$ VACUUM t;
$ SELECT pg_relation_filenode('t') AS filenode, pg_size_pretty(pg_relation_size('t')) AS size;
$ VACUUM FULL t;
$ SELECT pg_relation_filenode('t') AS filenode, pg_size_pretty(pg_relation_size('t')) AS size;
$ SQL
DELETE 12500
VACUUM
 filenode |  size   
----------+---------
    16442 | 5520 kB
(1 row)

VACUUM
