  "views": [
   {
    "id": "ship",
    "label": "전송",
    "focus": [
     "walbuf",
     "pgwal",
     "walsender",
     "walreceiver",
     "spgwal"
    ],
    "note": "walsender가 WAL을 WAL buffers(없으면 pg_wal 파일)에서 읽어 보내고, walreceiver가 받아 standby의 pg_wal에 쓰고 fsync합니다."
   },
   {
    "id": "replay",
    "label": "재생",
    "focus": [
     "spgwal",
     "startup",
     "sdata",
     "squery"
    ],
    "note": "standby의 startup 프로세스가 받은 WAL을 계속 재생합니다. 재생이 읽기 쿼리가 보는 행을 지워야 하면 충돌이 생깁니다."
   },
   {
    "id": "feedback",
    "label": "보고",
    "focus": [
     "walreceiver",
     "walsender",
     "slot",
     "syncrep",
     "backend"
    ],
    "note": "walreceiver가 같은 연결로 write, flush, apply 위치를 보고하면 walsender가 slot의 restart_lsn을 올리고, 동기 복제로 기다리는 커밋을 깨웁니다."
   }
  ]
 },
