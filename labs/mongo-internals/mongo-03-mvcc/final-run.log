######## 1. 스냅샷 격리: 트랜잭션은 시작할 때의 스냅샷을 끝까지 본다

# 세션 A 시작 (m03-1): mongosh 

# 세션 B 시작 (m03-1): mongosh 

[세션 A] rs0 [direct: primary] test> sA = db.getMongo().startSession(); cA = sA.getDatabase("test").acct;
test.acct

[세션 B] rs0 [direct: primary] test> sB = db.getMongo().startSession(); cB = sB.getDatabase("test").acct;
test.acct

[세션 A] rs0 [direct: primary] test> sA.startTransaction({readConcern: {level: "snapshot"}})

[세션 A] rs0 [direct: primary] test> cA.findOne({_id: 1})
{ _id: 1, balance: 100 }

[세션 B] rs0 [direct: primary] test> sB.startTransaction()

[세션 B] rs0 [direct: primary] test> cB.updateOne({_id: 1}, {$set: {balance: 200}})
{
  acknowledged: true,
  insertedId: null,
  matchedCount: 1,
  modifiedCount: 1,
  upsertedCount: 0
}

[세션 B] rs0 [direct: primary] test> sB.commitTransaction()

[세션 B] rs0 [direct: primary] test> sB.getOperationTime()
Timestamp({ t: 1790513779, i: 1 })

[세션 A] rs0 [direct: primary] test> cA.findOne({_id: 1})
{ _id: 1, balance: 100 }

rs0 [direct: primary] test> db.acct.findOne({_id: 1})
{ _id: 1, balance: 200 }
rs0 [direct: primary] test> db.getSiblingDB("admin").aggregate([{$currentOp: {idleSessions: true}}, {$match: {"transaction.parameters.autocommit": false}}, {$project: {_id: 0, active: 1, readConcern: "$transaction.parameters.readConcern.level", readTimestamp: "$transaction.readTimestamp", startWallClockTime: "$transaction.startWallClockTime", expiryTime: "$transaction.expiryTime"}}])
