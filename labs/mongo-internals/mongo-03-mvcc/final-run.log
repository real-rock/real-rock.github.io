$ URI=$(mongosh --quiet --eval 'db.ver.stats().wiredTiger.uri.replace("statistics:table:", "")')
$ mongod --dbpath /data/db --shutdown | grep -v '^{'
$ ID=$(wt -h /data/db list -v file:$URI.wt | tr ',' '\n' | grep '^id=' | cut -d= -f2)
$ echo "file:$URI.wt id=$ID"
