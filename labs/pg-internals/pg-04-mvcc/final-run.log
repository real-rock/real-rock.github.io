######## 5. 스냅샷: 아직 커밋 안 된 트랜잭션은 보이지 않는다

# 세션 A 시작: psql -X 

# 세션 B 시작: psql -X 

[세션 A] $ BEGIN;
BEGIN

[세션 A] $ SELECT pg_current_xact_id() AS a_xid;
 a_xid 
-------
   759
(1 row)


[세션 A] $ UPDATE acct SET balance = 999 WHERE id = 2;
UPDATE 1

$ psql -X -c "INSERT INTO acct VALUES (7, 100) RETURNING xmin AS other_xid"
 other_xid 
-----------
       760
(1 row)

INSERT 0 1
[exit=0]

[세션 A] $ SELECT pg_current_snapshot() AS a_snapshot, balance FROM acct WHERE id = 2;
 a_snapshot | balance 
------------+---------
 759:761:   |     999
(1 row)


[세션 B] $ BEGIN;
BEGIN

[세션 B] $ SELECT pg_current_snapshot() AS b_snapshot, balance FROM acct WHERE id = 2;
 b_snapshot  | balance 
-------------+---------
 759:761:759 |     100
(1 row)


[세션 A] $ COMMIT;
COMMIT

[세션 B] $ SELECT pg_current_snapshot() AS b_snapshot, balance FROM acct WHERE id = 2;
 b_snapshot | balance 
------------+---------
 761:761:   |     999
(1 row)


[세션 B] $ COMMIT;
COMMIT


######## 6. READ COMMITTED와 REPEATABLE READ

[세션 B] $ BEGIN ISOLATION LEVEL REPEATABLE READ;
BEGIN

[세션 B] $ SELECT pg_current_snapshot() AS b_snapshot, sum(balance) FROM acct;
 b_snapshot | sum  
------------+------
 761:761:   | 1349
(1 row)


[세션 A] $ UPDATE acct SET balance = balance + 1000 WHERE id = 3;
UPDATE 1

[세션 B] $ SELECT pg_current_snapshot() AS b_snapshot, sum(balance) FROM acct;
 b_snapshot | sum  
------------+------
 761:761:   | 1349
(1 row)


[세션 B] $ COMMIT;
COMMIT

[세션 B] $ SELECT pg_current_snapshot() AS b_snapshot, sum(balance) FROM acct;
 b_snapshot | sum  
------------+------
 762:762:   | 2349
(1 row)



######## 7. 같은 행을 동시에 고치면: READ COMMITTED

[세션 A] $ BEGIN;
BEGIN

[세션 A] $ UPDATE acct SET balance = balance + 10 WHERE id = 1 RETURNING balance;
